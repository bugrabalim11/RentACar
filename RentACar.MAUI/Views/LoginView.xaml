<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RentACar.MAUI.Views.LoginView"
             Title="LoginView">

    <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Center">

        <Label Text="RentACar'a Hoş Geldiniz!" FontSize="24" HorizontalOptions="Center" FontAttributes="Bold"/>

        <Entry Placeholder="E-posta adresiniz" 
               Text="{Binding Email}"
               Keyboard="Email" />
        
        <Entry Placeholder="Şifreniz" 
               Text="{Binding Password}"
               IsPassword="True"
               Keyboard="Password" />

        <Button Text="Giriş Yap"
                Command="{Binding LoginCommand}"
                CornerRadius="8"
                BackgroundColor="#2b3c5a"
                TextColor="White"/>

    </VerticalStackLayout>
</ContentPage>

