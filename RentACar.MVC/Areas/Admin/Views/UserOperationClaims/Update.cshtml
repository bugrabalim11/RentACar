@using RentACar.MVC.Areas.Admin.Models.UserOperationClaimDtos
@model UserOperationClaimUpdateViewModel

@{
    ViewData["Title"] = "Kullanıcı Rütbesi Güncelle";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Kullancı Rütbesi Güncelle</h5>
        </div>
        <div class="card-body">
            <form method="post" asp-action="Update">
                <input type="hidden" asp-for="UserOperationClaimUpdate.Id" />
                <div class="row">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Kullanıcı</label>

                            <!-- 1. GÖRÜNMEZ NINJA: Kuryenin API'ye taşıyacağı GERÇEK ID burada saklı! -->
                            <input type="hidden" asp-for="UserOperationClaimUpdate.UserId" />

                            <!-- 2. VİTRİN MANKENİ: Admin'in göreceği ama DOKUNAMAYACAĞI kilitli menü -->
                            <select asp-for="UserOperationClaimUpdate.UserId" disabled="disabled" class="form-control" asp-items="@(new SelectList(Model.Users, "Id", "FullName"))">
                                <option value="">Lütfen Kullanıcı Seçiniz...</option>
                            </select>

                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Rütbe</label>
                            <select asp-for="UserOperationClaimUpdate.OperationClaimId" class="form-control" asp-items="@(new SelectList(Model.Roles, "Id", "Name"))">
                                <option value="">Lütfen Rütbe Seçiniz...</option>
                            </select>
                            <span asp-validation-for="UserOperationClaimUpdate.OperationClaimId" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-4">Kaydet</button>
            </form>
        </div>
    </div>
</div>