@using RentACar.MVC.Areas.Admin.Models.UserOperationClaimDtos
@model UserOperationClaimCreateViewModel

@{
    ViewData["Title"] = "Kullanıcıya Yeni Rütbe Ekle";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Kullanıcıya Yeni Rütbe Ekle</h5>
        </div>
        <div class="card-body">
            <form method="post" asp-action="Create">
                <div class="row">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Kullanıcı</label>
                            <select asp-for="UserOperationClaimCreate.UserId" class="form-control" asp-items="@(new SelectList(Model.Users, "Id", "FullName"))">
                                <option value="">Lütfen Kullanıcı Seçiniz...</option>
                            </select>
                            <span asp-validation-for="UserOperationClaimCreate.UserId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Rütbe</label>
                                <select asp-for="UserOperationClaimCreate.OperationClaimId" class="form-control" asp-items="@(new SelectList(Model.Roles, "Id", "Name"))">
                                    <option value="">Lütfen Rütbe Seçiniz...</option>
                                </select>
                                <span asp-validation-for="UserOperationClaimCreate.OperationClaimId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-4">Kaydet</button>
            </form>
        </div>
    </div>
</div>