@using RentACar.MVC.Areas.Admin.Models.CarMaintenanceDtos
@model List<CarMaintenanceResultDto>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Araç Bakım Listesi</h5>
        <a asp-action="Create" class="btn btn-primary">Yeni Araç Bakımı Ekle</a>
    </div>

    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>
                        #
                    </th>
                    <th>
                        Araç
                    </th>
                    <th>
                        Açıklama
                    </th>
                    <th>
                        Giriş Tarihi
                    </th>
                    <th>
                        Çıkış Tarihi
                    </th>
                    <th>
                        Aksiyonlar
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.Id
                        </td>
                        <td>
                            @item.CarBrandModel
                        </td>
                        <td>
                            @item.Description
                        </td>
                        <td>
                            @item.CheckInTime.ToShortDateString()
                        </td>
                        <td>
                            @if (item.CheckOutTime.HasValue)
                            {
                                @item.CheckOutTime.Value.ToShortDateString()
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Hâlâ Sanayide</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detay</a>
                            <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-warning me-2">Güncelle</a>
                            <button onclick="deleteCarMaintenance(@item.Id)" class="btn btn-danger">Sil</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    function deleteCarMaintenance(id){
    Swal.fire({
    title:'Emin misin?',
    text:'Bu araç bakımını kalıcı olarak sileceksin!',
    icon:'warning',
    showCancelButton:true,
    confirmButtonColor:'#3085d6',
    cancelButtonColor:'#d33',
    confirmButtonText:'Evet, Sil!',
    cancelButtonText:'İptal'
    }).then((result)=>{
    if(result.isConfirmed){
    fetch('@Url.Action("Delete", "CarMaintenance", new { area = "Admin" })'+'/'+id,{
    method:'POST'
    })
    .then(response=>response.json())
    .then(data=>{
    if(data.success){
    window.location.reload();
    }else{
    Swal.fire('Hata!', data.message, 'error');
    }
    });
    }
    });
    }
</script>

