@using RentACar.MVC.Areas.Admin.Models.UserDtos
@model List<UserResultForAdminDto>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Kullanıcı Listesi</h5>
        <a asp-action="Create" class="btn btn-primary">Yeni Kullanıcı Ekle</a>
    </div>

    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>
                        #
                    </th>
                    <th>
                        İsim
                    </th>
                    <th>
                        Soyisim
                    </th>
                    <th>
                        E-posta
                    </th>
                    <th>
                        Silinmiş mi?
                    </th>
                    <th>
                        Silinme Tarihi
                    </th>
                    <th>
                        Aksiyonlar
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.Id
                        </td>
                        <td>
                            @item.FirstName
                        </td>
                        <td>
                            @item.LastName
                        </td>
                        <td>
                            @item.Email
                        </td>
                        <td>
                            @if (item.IsDeleted)
                            {
                                <span class="badge bg-danger">Pasif</span>
                            }
                            else
                            {

                                <span class="badge bg-success">Aktif</span>
                            }
                        </td>
                        <td>
                            @item.DeletedDate?.ToString("dd.MM.yyyy")
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-warning me-2">Güncelle</a>
                                <button onclick="deleteUser(@item.Id)" class="btn btn-danger">Sil</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    function deleteUser(id) {
        // Güvenlik görevlisini çağırıyoruz
        Swal.fire({
            title: 'Emin misin?',
            text: 'Bu kullanıcıyı kalıcı olarak sileceksin!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Evet, Sil!',
            cancelButtonText: 'İptal'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch('@Url.Action("Delete", "User", new { area = "Admin" })' + '/' + id, {
                    method: 'POST'
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            window.location.reload();
                        } else {
                            Swal.fire('Hata!', data.message, 'error');
                        }
                    });
            }
        });
    }
</script>
