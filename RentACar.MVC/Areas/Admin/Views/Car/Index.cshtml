@using RentACar.MVC.Areas.Admin.Models.CarDtos

@model List<CarResultDto>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Araç Listesi</h5>
        <a asp-action="Create" class="btn btn-primary">Yeni Araç Ekle</a>
    </div>

    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>
                        #
                    </th>
                    <th>
                        Brand Name
                    </th>
                    <th>
                        Model Name
                    </th>
                    <th>
                        Kilometer
                    </th>
                    <th>
                        Daily Price
                    </th>
                    <th>
                        Actions
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.Id
                        </td>
                        <td>
                            @item.BrandName
                        </td>
                        <td>
                            @item.ModelName
                        </td>
                        <td>
                            @item.Kilometer
                        </td>
                        <td>
                            @item.DailyPrice
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detay</a>
                                <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-warning me-2">Güncelle</a>
                                <button onclick="deleteCar(@item.Id)" class="btn btn-danger">Sil</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    function deleteCar(id){
    // Güvenlik görevlisini çağırıyoruz
    Swal.fire({
    title:'Emin misin?',
    text:'Bu aracı kalıcı olarak sileceksin!',
    icon:'warning',
    showCancelButton:true,
    confirmButtonColor:'#3085d6',
    cancelButtonColor:'#d33',
    confirmButtonText:'Evet, Sil!',
    cancelButtonText:'İptal'
    }).then((result)=>{
    if(result.isConfirmed){
    fetch('@Url.Action("Delete", "Car", new { area = "Admin" })'+'/'+id,{
    method:'POST'
    })
    .then(response=>response.json())
    .then(data=>{
    if(data.success){
    window.location.reload();
    }else{
    Swal.fire('Hata!', data.message, 'error');
    }
    });
    }
    });
    }
</script>
