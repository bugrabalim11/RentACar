@model RentACar.MVC.Areas.Admin.Models.ContactMessageDtos.ContactMessageResultDto

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Detaylar <span class="badge bg-success ms-2">Okundu</span></h5>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label fw-bold">Gönderen Adı</label>
            <p class="form-control bg-light">@Model.Name</p>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">E-posta</label>
            <p class="form-control bg-light">@Model.Email</p>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Konu</label>
            <p class="form-control bg-light">@Model.Subject</p>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Mesaj</label>
            <textarea class="form-control bg-light" rows="5" readonly>@Model.Message</textarea>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Gönderim Tarihi</label>
            <p class="form-control bg-light">@Model.SendDate.ToString("dd.MM.yyyy HH:mm")</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">Gelen Kutusuna Dön</a>
    </div>
</div>