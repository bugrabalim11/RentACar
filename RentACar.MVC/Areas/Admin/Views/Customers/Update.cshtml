@using RentACar.MVC.Areas.Admin.Models.CustomerDtos
@model CustomerUpdateByAdminViewModel

@{
    ViewData["Title"] = "Müşteri Güncelle";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Müşteri Güncelle</h5>
        </div>
        <div class="card-body">
            <form method="post" asp-action="Update">
                <input type="hidden" asp-for="CustomerUpdateByAdmin.Id" />
                <div class="row">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">TC Kimlik Numarası</label>
                            <input asp-for="CustomerUpdateByAdmin.NationalIdentity" class="form-control"  />
                            <span asp-validation-for="CustomerUpdateByAdmin.NationalIdentity" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Sürücü Lisans Yılı</label>
                            <input asp-for="CustomerUpdateByAdmin.DrivingLicenseYear" class="form-control" placeholder="Örn: 2020..." />
                            <span asp-validation-for="CustomerUpdateByAdmin.DrivingLicenseYear" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-4">Kaydet</button>
            </form>
        </div>
    </div>
</div>