@using RentACar.MVC.Areas.Admin.Models.CustomerDtos
@model CustomerCreateByAdminViewModel

@{
    ViewData["Title"] = "Yeni Müşteri Ekle";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Yeni Müşteri Ekle</h5>
        </div>
        <div class="card-body">
            <form method="post" asp-action="Create">
                <div class="row">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Kullanıcı</label>
                            <select asp-for="CustomerCreateByAdmin.UserId" class="form-control" asp-items="@(new SelectList(Model.Users, "Id", "UserDisplayInfo"))">
                                <option value="">Lütfen Kullanıcı Seçiniz...</option>
                            </select>
                            <span asp-validation-for="CustomerCreateByAdmin.UserId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">TC Kimlik Numarası</label>
                        <input asp-for="CustomerCreateByAdmin.NationalIdentity" class="form-control" />
                        <span asp-validation-for="CustomerCreateByAdmin.NationalIdentity" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Sürücü Lisanans Yılı</label>
                        <input asp-for="CustomerCreateByAdmin.DrivingLicenseYear" class="form-control" placeholder="Örn: 2020..." />
                        <span asp-validation-for="CustomerCreateByAdmin.DrivingLicenseYear" class="text-danger"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-4">Kaydet</button>
            </form>
        </div>
    </div>
</div>