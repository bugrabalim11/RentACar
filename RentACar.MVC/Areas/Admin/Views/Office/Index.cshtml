@using RentACar.MVC.Areas.Admin.Models.OfficeDtos

@model List<OfficeResultDto>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Ofis Listesi</h5>
        <a asp-action="Create" class="btn btn-primary">Yeni Ofis Ekle</a>
    </div>

    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>
                        #
                    </th>
                    <th>
                        Name
                    </th>
                    <th>
                        City
                    </th>
                    <th>
                        Contact Number
                    </th>
                    <th>
                        Actions
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.Id
                        </td>
                        <td>
                            @item.Name
                        </td>
                        <td>
                            @item.City
                        </td>
                        <td>
                            @item.ContactNumber
                        </td>
                        <td>
                            <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-warning me-2">Güncelle</a>
                            <button onclick="deleteOffice(@item.Id)" class="btn btn-danger">Sil</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    function deleteOffice(id){
    Swal.fire({
    title:'Emin misin?',
    text:'Bu ofisi kalıcı olarak sileceksin!',
    icon:'warning',
    showCancelButton:true,
    confirmButtonColor:'#3085d6',
    cancelButtonColor:'#d33',
    confirmButtonText:'Evet, Sil!',
    cancelButtonText:'İptal'
    }).then((result)=>{
    if(result.isConfirmed){
    fetch('@Url.Action("Delete", "Office", new { area = "Admin" })'+'/'+id,{
    method:'POST'
    })
    .then(response=>response.json())
    .then(data=>{
    if(data.success){
    window.location.reload();
    }else{
    Swal.fire('Hata!', data.message, 'error');
    }
    });
    }
    });
    }
</script>