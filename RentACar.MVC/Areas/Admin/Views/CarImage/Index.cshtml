@using RentACar.MVC.Areas.Admin.Models.CarImageDtos

@model List<RentACar.MVC.Areas.Admin.Models.CarImageDtos.CarImageResultDto>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        @Model.FirstOrDefault()?.CarName Resimleri
        <a asp-action="Create" asp-route-carId="@ViewBag.CarId" class="btn btn-primary">Yeni Araç Resmi Ekle</a>
    </div>

    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>
                        #
                    </th>
                    <th>
                        CarName
                    </th>
                    <th>
                        ImagePath
                    </th>
                    <th>
                        UploadDate
                    </th>
                    <th>
                        Actions
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.Id
                        </td>
                        <td>
                            @item.CarName
                        </td>
                        <td>
                            <img src="@item.ImagePath" width="100" class="rounded" />
                        </td>
                        <td>
                            @item.UploadDate.ToShortDateString()
                        </td>
                        <td>
                            <button onclick="deleteCarImage(@item.Id)" class="btn btn-danger">Sil</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    function deleteCarImage(id){
    Swal.fire({
    title:'Emin misin?',
    text:'Bu resmi kalıcı olarak sileceksin!',
    icon:'warning',
    showCancelButton:true,
    confirmButtonColor:'#3085d6',
    cancelButtonColor:'#d33',
    confirmButtonText:'Evet, Sil!',
    cancelButtonText:'İptal'
    }).then((result)=>{
    if(result.isConfirmed){
    fetch('@Url.Action("Delete", "CarImage", new { area = "Admin" })'+'/'+id,{
    method:'POST'
    })
    .then(response=>response.json())
    .then(data=>{
    if(data.success){
    window.location.reload();
    }else{
    Swal.fire('Hata!', data.message, 'error');
    }
    });
    }
    });
    }
</script>

