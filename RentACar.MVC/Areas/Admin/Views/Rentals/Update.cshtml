@using RentACar.MVC.Areas.Admin.Models.RentalDtos
@model RentalUpdateByAdminViewModel

@{
    ViewData["Title"] = "Araç Kiralama Güncelle";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Araç Kiralama Güncelle</h5>
        </div>
        <div class="card-body">
            <form method="post" asp-action="Update">
                <input type="hidden" asp-for="RentalUpdateByAdmin.Id" />
                <div class="row">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Araç</label>
                            <select asp-for="RentalUpdateByAdmin.CarId" class="form-control" asp-items="@(new SelectList(Model.Cars, "Id", "CarInfo"))">
                                <option value="">Lütfen Araç Seçiniz...</option>
                            </select>
                            <span asp-validation-for="RentalUpdateByAdmin.CarId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Araç Teslim Ofisi</label>
                            <select asp-for="RentalUpdateByAdmin.PickUpOfficeId" class="form-control" asp-items="@(new SelectList(Model.Offices, "Id", "OfficeInfo"))">
                                <option value="">Lütfen Ofis Seçiniz...</option>
                            </select>
                            <span asp-validation-for="RentalUpdateByAdmin.PickUpOfficeId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Araç İade Ofisi</label>
                            <select asp-for="RentalUpdateByAdmin.DropOffOfficeId" class="form-control" asp-items="@(new SelectList(Model.Offices, "Id", "OfficeInfo"))">
                                <option value="">Lütfen Ofis Seçiniz...</option>
                            </select>
                            <span asp-validation-for="RentalUpdateByAdmin.DropOffOfficeId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Araç Teslim Tarihi</label>
                            <input asp-for="RentalUpdateByAdmin.RentDate" class="form-control" type="date" />
                            <span asp-validation-for="RentalUpdateByAdmin.RentDate" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Araç İade Tarihi</label>
                            <input asp-for="RentalUpdateByAdmin.ReturnDate" class="form-control" type="date" />
                            <span asp-validation-for="RentalUpdateByAdmin.ReturnDate" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-4">Kaydet</button>
            </form>
        </div>
    </div>
</div>