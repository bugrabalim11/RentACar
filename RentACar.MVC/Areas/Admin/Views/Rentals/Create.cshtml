@using RentACar.MVC.Areas.Admin.Models.RentalDtos
@model RentalCreateByAdminViewModel

@{
    ViewData["Title"] = "Yeni Araç Kiralama Ekle";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Yeni Araç Kiralama Ekle</h5>
        </div>
        <div class="card-body">
            <form method="post" asp-action="Create">
                <div class="row">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Müşteri Adı</label>
                            <select asp-for="RentalCreateByAdmin.CustomerId" class="form-control" asp-items="@(new SelectList(Model.Customers, "Id", "FullName"))">
                                <option value="">Lütfen Müşteri Seçiniz...</option>
                            </select>
                            <span asp-validation-for="RentalCreateByAdmin.CustomerId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Araç</label>
                            <select asp-for="RentalCreateByAdmin.CarId" class="form-control" asp-items="@(new SelectList(Model.Cars, "Id", "CarInfo"))">
                                <option value="">Lütfen Araç Seçiniz...</option>
                            </select>
                            <span asp-validation-for="RentalCreateByAdmin.CarId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Araç Teslim Ofisi</label>
                            <select asp-for="RentalCreateByAdmin.PickUpOfficeId" class="form-control" asp-items="@(new SelectList(Model.Offices, "Id", "OfficeInfo"))">
                                <option value="">Lütfen Ofis Seçiniz...</option>
                            </select>
                            <span asp-validation-for="RentalCreateByAdmin.PickUpOfficeId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Araç İade Ofisi</label>
                            <select asp-for="RentalCreateByAdmin.DropOffOfficeId" class="form-control" asp-items="@(new SelectList(Model.Offices, "Id", "OfficeInfo"))">
                                <option value="">Lütfen Ofis Seçiniz...</option>
                            </select>
                            <span asp-validation-for="RentalCreateByAdmin.DropOffOfficeId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Araç Teslim Tarihi</label>
                            <input asp-for="RentalCreateByAdmin.RentDate" class="form-control" type="date" />
                            <span asp-validation-for="RentalCreateByAdmin.RentDate" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Araç İade Tarihi</label>
                            <input asp-for="RentalCreateByAdmin.ReturnDate" class="form-control" type="date" />
                            <span asp-validation-for="RentalCreateByAdmin.ReturnDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Kart Sahibi İsmi Ve Soyisimi</label>
                            <input asp-for="RentalCreateByAdmin.CreditCardInformation.CardHolderFullName" class="form-control" placeholder="Örn: Buğra Balım..." />
                            <span asp-validation-for="RentalCreateByAdmin.CreditCardInformation.CardHolderFullName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Kart Numarası</label>
                            <input asp-for="RentalCreateByAdmin.CreditCardInformation.CardNumber" class="form-control" placeholder="Örn: 1234567890123..." />
                            <span asp-validation-for="RentalCreateByAdmin.CreditCardInformation.CardNumber" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Kart Geçerlilik Yılı</label>
                            <input asp-for="RentalCreateByAdmin.CreditCardInformation.ExpireYear" class="form-control" placeholder="Örn: 2030..." />
                            <span asp-validation-for="RentalCreateByAdmin.CreditCardInformation.ExpireYear" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Kart Geçerlilik Ayı</label>
                            <input asp-for="RentalCreateByAdmin.CreditCardInformation.ExpireMonth" class="form-control" placeholder="Örn: 12..." />
                            <span asp-validation-for="RentalCreateByAdmin.CreditCardInformation.ExpireMonth" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">CVV</label>
                            <input asp-for="RentalCreateByAdmin.CreditCardInformation.Cvv" class="form-control" placeholder="Örn: 123..." />
                            <span asp-validation-for="RentalCreateByAdmin.CreditCardInformation.Cvv" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-4">Kaydet</button>
            </form>
        </div>
    </div>
</div>