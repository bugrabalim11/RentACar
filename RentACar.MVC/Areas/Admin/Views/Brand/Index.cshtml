@using RentACar.MVC.Areas.Admin.Models.BrandDtos

@model List<ResultBrandDto>

<div class="card">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>
                    #
                </th>
                <th>
                    Name
                </th>
                <th>
                    Actions
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.Id
                    </td>
                    <td>
                        @item.Name
                    </td>
                    <td>

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>