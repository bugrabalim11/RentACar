@{
    ViewData["Title"] = "Yeni Renk Ekle";
}

@model RentACar.MVC.Areas.Admin.Models.ColorDtos.ColorCreateDto

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Yeni Renk Ekle</h5>
        </div>
        <div class="card-body">
            <form method="post" asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label class="form-label">Renk Adı</label>
                    <input type="text" class="form-control" asp-for="Name" placeholder="Örn: Kırmızı, Beyaz..." />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Kaydet</button>
            </form>

        </div>
    </div>
</div>